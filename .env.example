# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# ---- Required: answer generator ----
LLM_PROVIDER=slm                    # slm | groq | openai | anthropic | openrouter
LLM_MODEL=llama3.2:latest           # e.g. llama3.1:8b (slm), llama-3.3-70b-versatile (groq), gpt-4o-mini (openai), claude-3-5-haiku-20241022 (anthropic), meta-llama/llama-3.1-8b-instruct (openrouter)
SLM_BASE_URL=http://localhost:11434/v1
SLM_API_KEY=ollama

# ---- Optional: embeddings ----
EMBED_MODEL=nomic-embed-text:latest   # Ollama embedding model
EMBED_BATCH=32                        # chunks per embedding API call

# ---- Optional: speech engines ----
STT_PROVIDER=local                  # local | groq | openai   (local = faster-whisper)
STT_MODEL=base                      # whisper size for faster-whisper
TTS_PROVIDER=pyttsx3                # pyttsx3 | piper | edge
TTS_VOICE=

# ---- Retrieval tuning ----
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
